# TennisConnect productie config (kopieer naar .env op de server)

# Verplicht: een sterk geheim voor JWT-tokens (genereer met: python -c "import secrets;print(secrets.token_urlsafe(48))")
TC_SECRET=verander-mij-naar-een-lang-random-geheim

# Optioneel: VAPID-keys voor echte push notifications.
# Genereer met:  python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PUBLIC=',v.public_key.hex(),'\nPRIVATE=',v.private_key.private_numbers().private_value.to_bytes(32,'big').hex())"
# of online:    https://web-push-codelab.glitch.me/
TC_VAPID_PUBLIC=
TC_VAPID_PRIVATE=
TC_VAPID_CONTACT=mailto:jij@jouw-domein.be

# Server config
PORT=5000
FLASK_DEBUG=0
